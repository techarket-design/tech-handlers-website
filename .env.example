# Copy this file to .env.local and fill in the public values from Supabase > Project Settings > API.
# These two VITE_ variables are public browser settings. Never put a service-role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional server-side settings. Needed for the lead API in a local SSR preview, not for `npm run dev` or `npm run build`.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
LEAD_RATE_LIMIT_SALT=
FORMSPREE_ENDPOINT=
CRON_SECRET=
# For local SSR preview, set this to http://127.0.0.1:4173
LEAD_ALLOWED_ORIGIN=http://127.0.0.1:4173
