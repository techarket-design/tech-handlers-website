# Server config
PORT=3000
NODE_ENV=production

# PostgreSQL connection
DB_URL=postgres://techhandlers:CHANGE_ME@localhost:5432/techhandlers

# JWT signing — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh

# CORS — comma-separated allowed origins (leave empty when API + frontend share origin via Nginx)
CORS_ORIGINS=https://techhandlers.in,https://www.techhandlers.in

# Local file storage
UPLOAD_DIR=/var/www/techhandlers/uploads
UPLOAD_PUBLIC_BASE=/uploads

# Lead notifications (optional — leave blank to skip Formspree forwarding)
FORMSPREE_URL=

# Cookies
COOKIE_DOMAIN=techhandlers.in
COOKIE_SECURE=true